---
// Página no encontrada. También la ven quienes llegan a direcciones del sitio anterior
// que ya no existen (actividades retiradas, noticias…).
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/Button.astro';

const shortcuts = [
  { label: 'Niveles educativos', href: '/niveles/inicial', text: 'Inicial, Básica y Media General' },
  { label: 'Extracátedras', href: '/actividades', text: 'Ajedrez y danza' },
  { label: 'Nuestra historia', href: '/nosotros/historia', text: 'Desde 1991 en Guaracarumbo' },
  { label: 'Documentos', href: '/documentos', text: 'Acuerdos y planillas' },
];
---

<PageLayout title="Página no encontrada" noindex>
  <section class="relative overflow-hidden bg-linear-to-b from-sky-50 via-white to-white">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="glow-sky absolute -top-56 -left-56 size-[38rem]"></div>
      <div class="glow-gold absolute top-1/4 -right-48 size-[34rem]"></div>
    </div>

    <div class="relative mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:py-28">
      <p class="animate-fade-up font-display text-8xl font-extrabold text-gold-500 sm:text-9xl">404</p>
      <h1 class="mt-4 animate-fade-up text-3xl animate-delay-60 sm:text-4xl">Esta página no está en el recreo… ni en ningún otro lado</h1>
      <p class="mx-auto mt-5 max-w-xl animate-fade-up text-lg animate-delay-120">
        Puede que la dirección haya cambiado con nuestro sitio nuevo. Prueba con alguna de estas secciones o vuelve al
        inicio.
      </p>
      <div class="mt-8 flex animate-fade-up flex-wrap justify-center gap-3 animate-delay-180">
        <Button href="/">Ir al inicio</Button>
        <Button href="/contacto" variant="outline">Contáctanos</Button>
      </div>

      <ul class="mt-14 grid animate-fade-up gap-4 text-left animate-delay-260 sm:grid-cols-2">
        {
          shortcuts.map((s) => (
            <li>
              <a
                href={s.href}
                class="group flex items-center justify-between gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-navy-100 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-navy-900/10"
              >
                <span>
                  <span class="block font-display font-bold text-navy-900">{s.label}</span>
                  <span class="text-sm text-slate-500">{s.text}</span>
                </span>
                <ArrowUpRight
                  size={18}
                  class="shrink-0 text-navy-900 transition-transform duration-300 group-hover:rotate-45"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</PageLayout>
