---
// Guía de estilos interna para validar el diseño. Solo existe en desarrollo:
// es una ruta dinámica que en producción no genera ninguna página (no se publica).
import type { GetStaticPaths } from 'astro';

import PageLayout from '../layouts/PageLayout.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import { site, stats } from '../data/site';

export const getStaticPaths = (() =>
  import.meta.env.DEV ? [{ params: { styleguide: 'styleguide' } }] : []) satisfies GetStaticPaths;

const palettes = [
  { name: 'navy', brand: 900, shades: [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950] },
  { name: 'gold', brand: 500, shades: [50, 100, 200, 300, 400, 500, 600, 700, 800, 900] },
  { name: 'sky', brand: 200, shades: [50, 100, 200, 300, 400] },
];

// Tailwind solo genera las clases que ve escritas completas en el código,
// por eso no se puede armar `bg-${name}-${shade}` dinámicamente: usamos style.
const swatch = (name: string, shade: number) => `background: var(--color-${name}-${shade})`;
---

<PageLayout title="Guía de estilos" noindex>
  <div class="mx-auto max-w-6xl space-y-24 px-4 py-16 sm:px-6">
    <header class="flex flex-col items-start gap-6 animate-fade-up">
      <Logo size={72} />
      <p class="font-script text-3xl text-gold-600 animate-fade-in animate-delay-300">Niños Cantores de La Guaira</p>
      <h1 class="text-5xl sm:text-6xl animate-fade-up animate-delay-150">
        Guía de estilos <span class="text-gold-500">Escolanía</span>
      </h1>
      <p class="max-w-2xl text-lg animate-fade-up animate-delay-300">{site.description}</p>
      <div class="flex flex-wrap gap-3 animate-fade-up animate-delay-500">
        <Button href="#colores">Inscripciones</Button>
        <Button href="#tipografia" variant="secondary">Conócenos</Button>
        <Button href="#animaciones" variant="outline">Ver animaciones</Button>
      </div>
    </header>

    <section id="colores" class="space-y-8">
      <h2 class="text-3xl reveal">Paleta</h2>
      {
        palettes.map(({ name, brand, shades }) => (
          <div class="reveal">
            <h3 class="mb-3 text-lg capitalize">{name}</h3>
            <div class="grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-11">
              {shades.map((shade) => (
                <div>
                  <div
                    class:list={['h-16 rounded-xl', shade === brand && 'ring-2 ring-gold-500 ring-offset-2']}
                    style={swatch(name, shade)}
                  />
                  <p class="mt-1 text-xs text-slate-500">
                    {shade}
                    {shade === brand && ' · marca'}
                  </p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section id="tipografia" class="space-y-6">
      <h2 class="text-3xl reveal">Tipografía</h2>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="reveal rounded-2xl bg-sky-50 p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-600">Display · Plus Jakarta Sans</p>
          <p class="mt-3 font-display text-4xl font-extrabold text-navy-900">Un mañana más brillante</p>
        </div>
        <div class="reveal rounded-2xl bg-sky-50 p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-600">Texto · Inter</p>
          <p class="mt-3">
            Fundamentada en cuatro columnas de nuestra educación: moral y religiosa, intelectual, musical y
            físico-deportiva.
          </p>
        </div>
        <div class="reveal rounded-2xl bg-sky-50 p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-600">Acento · Caveat</p>
          <p class="mt-3 font-script text-4xl text-navy-800">¡A la vanguardia educativa!</p>
        </div>
      </div>
    </section>

    <section id="animaciones" class="space-y-6">
      <h2 class="text-3xl reveal">Animaciones</h2>
      <p class="reveal">
        Las tarjetas usan <code class="rounded bg-navy-50 px-1.5 py-0.5 text-navy-900">reveal</code>: aparecen
        al hacer scroll, solo con CSS.
      </p>
      <div class="grid gap-4 rounded-3xl bg-navy-900 p-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map(({ value, label }) => (
            <div class="reveal text-center">
              <p class="font-display text-4xl font-extrabold text-gold-400">{value ?? '—'}</p>
              <p class="mt-1 text-sm text-navy-100">{label}</p>
            </div>
          ))
        }
      </div>
      <div class="flex items-center gap-4">
        <span class="inline-block size-16 rounded-2xl bg-gold-500 animate-float"></span>
        <span class="font-script text-2xl text-navy-800">animate-float</span>
      </div>
    </section>
  </div>
</PageLayout>
