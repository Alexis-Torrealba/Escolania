---
import FileText from '@lucide/astro/icons/file-text';
import Download from '@lucide/astro/icons/download';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { documents, documentCategories } from '../data/resources';

const formatSize = (kb: number) =>
  kb >= 1024 ? `${(kb / 1024).toLocaleString('es-VE', { maximumFractionDigits: 1 })} MB` : `${kb} KB`;
---

<PageLayout
  title="Documentos"
  description="Descarga los Acuerdos de Convivencia, el Acta de Compromiso y las planillas de labor social de la U.E.P. Escolanía."
>
  <PageHero
    eyebrow="Recursos"
    title="Documentos para "
    highlight="descargar"
    label="Documentos"
    breadcrumbs={[{ label: 'Recursos' }]}
    description="Normas de convivencia, actas y planillas que necesitan representantes y estudiantes. Todos en PDF, listos para imprimir."
  />

  <div class="mx-auto max-w-5xl space-y-16 px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    {
      documentCategories.map((category) => (
        <section aria-labelledby={`cat-${category.value}`}>
          <div class="reveal border-b border-navy-100 pb-4">
            <h2 id={`cat-${category.value}`} class="text-2xl sm:text-3xl">
              {category.value}
            </h2>
            <p class="mt-1 text-slate-500">{category.description}</p>
          </div>
          <ul class="mt-6 space-y-4">
            {documents
              .filter((d) => d.category === category.value)
              .map((d) => (
                <li class="reveal">
                  <a
                    href={d.href}
                    download
                    class="group flex flex-col gap-5 rounded-3xl bg-white p-5 shadow-sm ring-1 ring-navy-100 transition-all duration-300 ease-out-expo hover:-translate-y-0.5 hover:shadow-xl hover:shadow-navy-900/10 sm:flex-row sm:items-center sm:p-6"
                  >
                    <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-navy-900 text-gold-400">
                      <FileText size={24} aria-hidden="true" />
                    </span>
                    <div class="flex-1">
                      <h3 class="text-lg">{d.title}</h3>
                      <p class="mt-1 text-sm text-slate-600">{d.description}</p>
                      <p class="mt-2 text-xs font-semibold text-slate-400">
                        PDF · {formatSize(d.sizeKB)}
                        {d.schoolYear && ` · Año escolar ${d.schoolYear}`}
                      </p>
                    </div>
                    <span class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-gold-500 px-5 py-2.5 text-sm font-semibold text-navy-900 transition-colors group-hover:bg-gold-400 sm:self-center">
                      <Download size={16} aria-hidden="true" />
                      Descargar
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }

    <aside class="reveal rounded-3xl bg-sky-50/70 p-8 text-center ring-1 ring-navy-100">
      <h2 class="text-xl">¿No encuentras un documento?</h2>
      <p class="mt-2 text-slate-600">Escríbenos y te ayudamos a conseguirlo.</p>
      <Button href="/contacto" variant="secondary" class="mt-6">Contáctanos</Button>
    </aside>
  </div>
</PageLayout>
