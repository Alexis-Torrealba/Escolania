---
import Stethoscope from '@lucide/astro/icons/stethoscope';
import Toothbrush from '@lucide/astro/icons/toothbrush';
import Brain from '@lucide/astro/icons/brain';
import HandHeart from '@lucide/astro/icons/hand-heart';
import Compass from '@lucide/astro/icons/compass';
import BookOpenCheck from '@lucide/astro/icons/book-open-check';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Mail from '@lucide/astro/icons/mail';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import CallToAction from '../components/CallToAction.astro';
import { wellbeing, wellbeingServices } from '../data/school-life';

const icons = {
  medical: Stethoscope,
  dental: Toothbrush,
  psychology: Brain,
  social: HandHeart,
  guidance: Compass,
  tutoring: BookOpenCheck,
};
---

<PageLayout
  title="Bienestar estudiantil"
  description="Servicio médico, orientación, trabajo social y acompañamiento: la Coordinación de Bienestar Estudiantil de la U.E.P. Escolanía."
>
  <PageHero
    eyebrow="Vida escolar"
    title="Bienestar "
    highlight="estudiantil"
    breadcrumbs={[{ label: 'Vida escolar' }]}
    description={wellbeing.purpose}
  >
    <Button href={`mailto:${wellbeing.email}`} variant="secondary">
      <Mail size={16} aria-hidden="true" />
      Escribir a Bienestar
    </Button>
  </PageHero>

  <!-- Servicios -->
  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8 lg:pb-28">
    <SectionHeading eyebrow="Servicios" title="Acompañamos a cada " highlight="escolano">
      {wellbeing.purposeExtra}
    </SectionHeading>
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        wellbeingServices.map((s) => {
          const Icon = icons[s.icon];
          return (
            <li class="reveal flex flex-col rounded-3xl bg-white p-7 shadow-sm ring-1 ring-navy-100">
              <span class="grid size-12 place-items-center rounded-2xl bg-navy-900 text-gold-400">
                <Icon size={22} aria-hidden="true" />
              </span>
              <h3 class="mt-5 text-xl">{s.title}</h3>
              <p class="mt-2 flex-1 text-slate-600">{s.text}</p>
              {s.email && (
                <a
                  href={`mailto:${s.email}`}
                  class="mt-5 inline-flex items-center gap-2 text-sm font-semibold break-all text-navy-900 underline decoration-gold-400 decoration-2 underline-offset-4 hover:text-gold-600"
                >
                  <Mail size={14} class="shrink-0" aria-hidden="true" />
                  {s.email}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- Deberes y funciones -->
  <section class="bg-navy-900">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_1.4fr] lg:px-8 lg:py-24">
      <SectionHeading eyebrow="Nuestro compromiso" title="Deberes y " highlight="funciones" tone="dark">
        La Coordinación de Bienestar Estudiantil trabaja junto a docentes, representantes y estudiantes.
      </SectionHeading>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          wellbeing.duties.map((duty) => (
            <li class="reveal flex gap-4 rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
              <ShieldCheck size={22} class="mt-0.5 shrink-0 text-gold-400" aria-hidden="true" />
              <span class="text-navy-50">{duty}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CallToAction />
</PageLayout>
