---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import SectionHeading from '../SectionHeading.astro';
import { levels } from '../../data/education';
---

<section class="bg-sky-50/70">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <SectionHeading eyebrow="Niveles educativos" title="Un camino completo, de Inicial a " highlight="Media General" />
      <p class="reveal max-w-md text-slate-600 lg:text-right">
        Acompañamos a nuestros escolanos en cada etapa, con aulas para cada grado y año.
      </p>
    </div>

    <ul class="mt-14 grid gap-6 md:grid-cols-3">
      {
        levels.map((level) => (
          <li class="reveal">
            <a
              href={`/niveles/${level.slug}`}
              class="group block h-full overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-navy-100 transition-all duration-500 ease-out-expo hover:-translate-y-2 hover:shadow-2xl hover:shadow-navy-900/10"
            >
              <div class="relative overflow-hidden">
                <Image
                  src={level.image}
                  alt={level.imageAlt}
                  widths={[400, 640, 800]}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  class="aspect-4/3 w-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
                />
                <span class="absolute top-4 left-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-navy-900">
                  {level.grades}
                </span>
              </div>
              <div class="flex items-center justify-between gap-4 p-6">
                <div>
                  <h3 class="text-xl">{level.title}</h3>
                  <p class="mt-1 text-sm text-slate-500">{level.tagline}</p>
                </div>
                <span class="grid size-11 shrink-0 place-items-center rounded-full ring-1 ring-navy-100 transition-all duration-300 group-hover:bg-gold-500 group-hover:ring-gold-500">
                  <ArrowUpRight
                    size={18}
                    class="text-navy-900 transition-transform duration-300 group-hover:rotate-45"
                  />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
