---
// Distintivo pequeño «Inicial + 3 cuotas con Cashea», con el ícono y el color de la marca Cashea.
import { Image } from 'astro:assets';
import casheaIcon from '../assets/pago/Cashea.png';
import { casheaPlan } from '../data/site';

interface Props {
  /** Si se indica, el distintivo es un enlace */
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center gap-2 rounded-full bg-cashea py-1 pr-3.5 pl-1 text-sm font-bold text-cashea-ink',
    href &&
      'transition-transform duration-300 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cashea-ink',
    className,
  ]}
>
  <Image src={casheaIcon} alt="" width={56} height={56} class="size-7 rounded-full" />
  {casheaPlan} con Cashea
</Tag>
