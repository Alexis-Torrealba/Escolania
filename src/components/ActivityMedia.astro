---
// Foto de una actividad; si no tiene foto, un panel navy con su ícono y un fondo temático.
import { Image } from 'astro:assets';
import ChessKnight from '@lucide/astro/icons/chess-knight';
import Footprints from '@lucide/astro/icons/footprints';
import type { Activity } from '../data/activities';

interface Props {
  activity: Activity;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { activity, widths, sizes, loading = 'lazy', class: className } = Astro.props;
const icons = { chess: ChessKnight, dance: Footprints };
const Icon = icons[activity.icon];
---

{
  activity.image ? (
    <Image
      src={activity.image}
      alt={`Escolanos en la actividad de ${activity.name.toLowerCase()}`}
      widths={widths}
      sizes={sizes}
      loading={loading}
      class:list={['object-cover', className]}
    />
  ) : (
    <div
      class:list={['media-placeholder relative grid place-items-center overflow-hidden bg-navy-900', className]}
      data-pattern={activity.icon}
      role="img"
      aria-label={activity.name}
    >
      <Icon class="relative size-1/3 max-h-40 text-gold-400" stroke-width={1.25} aria-hidden="true" />
    </div>
  )
}

<style>
  .media-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.08;
    mask-image: radial-gradient(circle at center, black 20%, transparent 75%);
  }
  /* Ajedrez: tablero */
  .media-placeholder[data-pattern='chess']::before {
    background: repeating-conic-gradient(white 0 25%, transparent 0 50%) 0 0 / 4rem 4rem;
  }
  /* Danza: ondas concéntricas, como el ritmo que se expande */
  .media-placeholder[data-pattern='dance']::before {
    opacity: 0.12;
    background: repeating-radial-gradient(circle at center, white 0 2px, transparent 2px 1.75rem);
  }
</style>
