---
// Cabecera de las páginas internas: migas de pan, título y, opcionalmente, una foto.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ChevronRight from '@lucide/astro/icons/chevron-right';

interface Props {
  title: string;
  /** Parte del título resaltada en dorado (se añade al final) */
  highlight?: string;
  eyebrow?: string;
  description?: string;
  /** Migas intermedias; «Inicio» y la página actual se añaden solas */
  breadcrumbs?: { label: string; href?: string }[];
  /** Nombre corto de la página en las migas (por defecto, el título completo) */
  label?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, highlight, eyebrow, description, breadcrumbs = [], label, image, imageAlt = '' } = Astro.props;
const current = label ?? `${title}${highlight ?? ''}`.trim();
// slot="media" sustituye a `image` cuando el visual no es una foto simple
const hasMedia = !!image || Astro.slots.has('media');
const trail = [{ label: 'Inicio', href: '/' }, ...breadcrumbs, { label: current }];
---

<section class="relative overflow-hidden bg-linear-to-b from-sky-50 via-sky-50/60 to-white">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="glow-sky absolute -top-56 -left-56 size-[38rem]"></div>
    <div class="glow-gold absolute top-0 -right-48 size-[32rem]"></div>
  </div>

  <div
    class:list={[
      'relative mx-auto max-w-7xl px-4 pt-10 pb-16 sm:px-6 lg:px-8 lg:pt-14 lg:pb-20',
      hasMedia && 'grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]',
    ]}
  >
    <div>
      <nav aria-label="Migas de pan" class="animate-fade-in">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-500">
          {
            trail.map((crumb, i) => (
              <li class="flex items-center gap-1.5">
                {i > 0 && <ChevronRight size={14} class="text-slate-400" aria-hidden="true" />}
                {crumb.href ? (
                  <a href={crumb.href} class="transition-colors hover:text-navy-900">
                    {crumb.label}
                  </a>
                ) : (
                  <span aria-current="page" class="font-medium text-navy-900">
                    {crumb.label}
                  </span>
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      {
        eyebrow && (
          <p class="mt-8 animate-fade-up text-xs font-bold tracking-[0.25em] text-gold-600 uppercase">{eyebrow}</p>
        )
      }
      <h1
        class:list={[
          'animate-fade-up text-4xl leading-[1.08] animate-delay-60 sm:text-5xl lg:text-6xl',
          eyebrow ? 'mt-3' : 'mt-8',
        ]}
      >
        {title}
        {highlight && <span class="text-gold-500">{highlight}</span>}
      </h1>
      {
        description && (
          <p class="mt-6 max-w-2xl animate-fade-up text-lg leading-relaxed animate-delay-120 sm:text-xl">
            {description}
          </p>
        )
      }
      {
        Astro.slots.has('default') && (
          <div class="mt-8 animate-fade-up animate-delay-180">
            <slot />
          </div>
        )
      }
    </div>

    {
      hasMedia && (
        <div class="relative animate-scale-in animate-delay-120">
          <div class="absolute -inset-3 -z-0 rotate-2 rounded-[2.5rem] bg-gold-200/50" aria-hidden="true" />
          <div class="relative overflow-hidden rounded-[2rem] shadow-2xl shadow-navy-900/15">
            {image ? (
              <Image
                src={image}
                alt={imageAlt}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 45vw, 100vw"
                loading="eager"
                class="parallax aspect-4/3 w-full scale-110 object-cover"
              />
            ) : (
              <slot name="media" />
            )}
          </div>
        </div>
      )
    }
  </div>
</section>
