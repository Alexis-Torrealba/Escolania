---
import Phone from '@lucide/astro/icons/phone';
import Mail from '@lucide/astro/icons/mail';
import Clock from '@lucide/astro/icons/clock';
import CircleUserRound from '@lucide/astro/icons/circle-user-round';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import Logo from './Logo.astro';
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';
import { contact, links } from '../data/site';
import { mainNav, isGroup, type NavLink } from '../data/navigation';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const groupActive = (children: NavLink[]) => children.some((c) => !c.external && isActive(c.href));
const externalAttrs = (l: NavLink) => (l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<a
  href="#contenido"
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-gold-700 focus:px-5 focus:py-2 focus:font-semibold focus:text-white"
>
  Saltar al contenido
</a>

<!-- Top bar -->
<div class="bg-navy-900 text-sm text-navy-100">
  <div class="mx-auto flex h-10 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <ul class="flex items-center gap-5">
      <li>
        <a href={contact.phoneHref} class="flex items-center gap-2 transition-colors hover:text-gold-300">
          <Phone size={14} class="text-gold-400" />
          {contact.phone}
        </a>
      </li>
      <li class="hidden md:block">
        <a href={`mailto:${contact.email}`} class="flex items-center gap-2 transition-colors hover:text-gold-300">
          <Mail size={14} class="text-gold-400" />
          {contact.email}
        </a>
      </li>
      <li class="hidden items-center gap-2 xl:flex">
        <Clock size={14} class="text-gold-400" />
        {contact.hours}
      </li>
    </ul>
    <div class="flex items-center gap-3">
      <a
        href={links.portal}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 font-medium transition-colors hover:text-gold-300"
      >
        <CircleUserRound size={15} class="text-gold-400" />
        <span class="hidden sm:inline">Portal de representantes</span>
        <span class="sm:hidden">Portal</span>
      </a>
      <span class="h-4 w-px bg-white/15" aria-hidden="true"></span>
      <SocialLinks size={14} itemClass="size-7 hover:bg-white/10 hover:text-gold-300" />
    </div>
  </div>
</div>

<!-- Barra principal -->
<header class="site-header sticky top-0 z-50 border-b border-transparent bg-white/90 backdrop-blur-md">
  <nav aria-label="Principal" class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <Logo size={52} />

    <!-- Desktop -->
    <ul class="hidden items-center gap-1 lg:flex">
      {
        mainNav.map((item) =>
          isGroup(item) ? (
            <li class="group relative">
              <button
                type="button"
                aria-haspopup="true"
                class:list={[
                  'nav-link flex items-center gap-1',
                  groupActive(item.children) && 'is-active',
                ]}
              >
                {item.label}
                <ChevronDown
                  size={15}
                  class="transition-transform duration-300 group-focus-within:rotate-180 group-hover:rotate-180"
                />
              </button>
              <div class="invisible absolute top-full left-1/2 w-80 -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-300 ease-out-expo group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                <ul class="rounded-2xl bg-white p-2 shadow-xl ring-1 shadow-navy-900/10 ring-navy-100">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        {...externalAttrs(child)}
                        aria-current={isActive(child.href) ? 'page' : undefined}
                        class="group/item flex items-start justify-between gap-3 rounded-xl px-4 py-3 transition-colors hover:bg-sky-50 aria-[current=page]:bg-sky-50"
                      >
                        <span>
                          <span class="block text-sm font-semibold text-navy-900">{child.label}</span>
                          {child.description && (
                            <span class="mt-0.5 block text-xs text-slate-500">{child.description}</span>
                          )}
                        </span>
                        {child.external && (
                          <ArrowUpRight
                            size={16}
                            class="mt-0.5 shrink-0 text-gold-500 transition-transform group-hover/item:translate-x-0.5 group-hover/item:-translate-y-0.5"
                          />
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={['nav-link', isActive(item.href) && 'is-active']}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>

    <div class="flex items-center gap-3">
      <div class="hidden xl:block">
        <Button href={links.portal} external>Inscripciones</Button>
      </div>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="group grid size-11 place-items-center rounded-full text-navy-900 ring-1 ring-navy-100 transition-colors hover:bg-navy-50 lg:hidden"
      >
        <span class="sr-only">Abrir menú</span>
        <Menu size={22} class="group-aria-expanded:hidden" />
        <X size={22} class="hidden group-aria-expanded:block" />
      </button>
    </div>
  </nav>

  <!-- Móvil -->
  <div
    id="mobile-menu"
    hidden
    class="max-h-[calc(100dvh-5rem)] animate-fade-in overflow-y-auto border-t border-navy-100 bg-white lg:hidden"
  >
    <ul class="mx-auto max-w-7xl space-y-1 px-4 py-4 sm:px-6">
      {
        mainNav.map((item) =>
          isGroup(item) ? (
            <li>
              <details class="group/acc" open={groupActive(item.children)}>
                <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl px-4 py-3 font-display font-semibold text-navy-900 hover:bg-sky-50 [&::-webkit-details-marker]:hidden">
                  {item.label}
                  <ChevronDown size={18} class="transition-transform duration-300 group-open/acc:rotate-180" />
                </summary>
                <ul class="mt-1 mb-2 ml-4 space-y-1 border-l-2 border-gold-200 pl-3">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        {...externalAttrs(child)}
                        aria-current={isActive(child.href) ? 'page' : undefined}
                        class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-sky-50 hover:text-navy-900 aria-[current=page]:font-semibold aria-[current=page]:text-navy-900"
                      >
                        {child.label}
                        {child.external && <ArrowUpRight size={14} class="text-gold-500" />}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="block rounded-xl px-4 py-3 font-display font-semibold text-navy-900 hover:bg-sky-50 aria-[current=page]:bg-sky-50"
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>
    <div class="mx-auto max-w-7xl px-4 pb-6 sm:px-6">
      <Button href={links.portal} external class="w-full justify-center">Inscripciones</Button>
    </div>
  </div>
</header>

<style>
  /* Enlaces de primer nivel con subrayado dorado animado */
  .nav-link {
    position: relative;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: color-mix(in oklab, var(--color-navy-900) 75%, transparent);
    transition: color 0.3s;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.15rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-gold-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out-expo);
  }
  .nav-link:hover,
  .nav-link.is-active,
  :global(.group:focus-within) > .nav-link {
    color: var(--color-navy-900);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  /* Sombra al hacer scroll, sin JavaScript (scroll-driven animation):
     la animación avanza con los primeros 80px de scroll de la página. */
  @keyframes header-scrolled {
    to {
      background-color: rgb(255 255 255 / 0.97);
      border-color: var(--color-navy-100);
      box-shadow: 0 10px 30px -15px rgb(13 30 91 / 0.25);
    }
  }
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-scrolled linear both;
      animation-timeline: scroll();
      animation-range: 0 80px;
    }
  }
</style>

<script>
  // Con ClientRouter las páginas se cambian sin recargar, así que el menú se
  // inicializa en cada 'astro:page-load'. El AbortController limpia los
  // listeners globales de la página anterior para que no se acumulen.
  let controller: AbortController | undefined;

  function setupMobileMenu() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.getElementById('mobile-menu');
    if (!toggle || !panel) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('.sr-only')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
      panel.hidden = !open;
      document.documentElement.classList.toggle('overflow-hidden', open);
    };

    setOpen(false);
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'), { signal });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false), { signal });
    // Si se agranda la ventana a escritorio con el menú abierto, lo cerramos
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setOpen(false), { signal });
  }

  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
