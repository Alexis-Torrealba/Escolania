---
// Pestañas entre las páginas de «Nosotros». Los enlaces salen del menú principal.
import { mainNav, isGroup } from '../data/navigation';

const group = mainNav.find((item) => isGroup(item) && item.label === 'Nosotros');
const items = group && isGroup(group) ? group.children : [];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<nav aria-label="Secciones de Nosotros" class="sticky top-20 z-40 border-y border-navy-100 bg-white/95">
  <ul class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-4 sm:px-6 lg:px-8 [scrollbar-width:none]">
    {
      items.map((item) => {
        const active = current === item.href;
        return (
          <li class="shrink-0">
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative block px-4 py-3.5 text-sm font-semibold transition-colors',
                active ? 'text-navy-900' : 'text-slate-500 hover:text-navy-900',
              ]}
            >
              {item.label}
              {active && <span class="absolute inset-x-4 bottom-0 h-0.5 rounded-full bg-gold-500" />}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
