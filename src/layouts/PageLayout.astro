---
// Layout de todas las páginas públicas: Header + contenido + Footer.
import type { TransitionAnimationPair } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const props = Astro.props;

// Al cambiar de página solo se anima el contenido: sale rápido hacia arriba y el nuevo
// entra subiendo. Corto para que la navegación se sienta inmediata.
const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';
const pageSwap: TransitionAnimationPair = {
  old: { name: 'page-out', duration: '160ms', easing: 'ease-in', fillMode: 'both' },
  new: { name: 'page-in', duration: '420ms', easing: ease, fillMode: 'both' },
};
const pageAnimation = { forwards: pageSwap, backwards: pageSwap };
---

<BaseLayout {...props}>
  <!-- Progreso de lectura: línea dorada que avanza con el scroll -->
  <div
    class="scroll-progress fixed inset-x-0 top-0 z-[60] h-[3px] bg-linear-to-r from-gold-500 to-gold-300"
    aria-hidden="true"
    transition:name="scroll-progress"
    transition:animate="none"
  >
  </div>
  <Header />
  <main id="contenido" transition:name="page-content" transition:animate={pageAnimation}>
    <slot />
  </main>
  <Footer />
</BaseLayout>
