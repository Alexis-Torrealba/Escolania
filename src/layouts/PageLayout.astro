---
// Layout de todas las páginas públicas: Header + contenido + Footer.
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = {
  title?: string;
  description?: string;
};

const props = Astro.props;
---

<BaseLayout {...props}>
  <Header />
  <main id="contenido">
    <slot />
  </main>
  <Footer />
</BaseLayout>
