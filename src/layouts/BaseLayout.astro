---
import { ClientRouter } from 'astro:transitions';
import { site, contact, links } from '../data/site';
import { foundingYear } from '../data/about';
import '../styles/global.css';
// Fuentes que se ven en la primera pantalla: se precargan para que el texto aparezca ya
// con su tipografía (sin el «salto» de la fuente provisional). Mismo archivo que usa
// @fontsource en global.css, así que no se descarga dos veces.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Oculta la página de los buscadores (páginas internas) */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.fullName;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Imagen al compartir en WhatsApp / redes (1200×630). Fuente: public/og-image.jpg
const ogImage = new URL('/og-image.jpg', Astro.site);
const ogImageAlt = `${site.fullName}: escolanos con el uniforme de la Escolanía`;

// Ficha de la escuela para Google (datos estructurados). Solo en la portada.
const isHome = Astro.url.pathname === '/';
const schoolSchema = {
  '@context': 'https://schema.org',
  '@type': 'School',
  name: site.fullName,
  alternateName: site.name,
  url: site.url,
  logo: new URL('/android-chrome-192x192.png', Astro.site).href,
  image: ogImage.href,
  description: site.description,
  foundingDate: String(foundingYear),
  telephone: contact.phoneHref.replace('tel:', ''),
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address,
    addressLocality: 'Guaracarumbo',
    addressRegion: 'La Guaira',
    addressCountry: 'VE',
  },
  sameAs: [links.facebook, links.instagram, links.youtube],
};
---

<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph: la tarjeta que aparece al compartir en WhatsApp / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(schoolSchema)} />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0d1e5b" />
    <meta name="generator" content={Astro.generator} />

    <!-- Transiciones suaves entre páginas (View Transitions API) -->
    <ClientRouter />

    <!-- Activa las animaciones de aparición antes de pintar (sin parpadeo). Si el usuario
         pidió reducir el movimiento, o el script de src/scripts/motion.ts no llega a cargar,
         todo el contenido se muestra normal. -->
    <script is:inline>
      (() => {
        const ok = 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.__motionOk = ok;
        if (!ok) return;
        document.documentElement.classList.add('reveal-ready');
        setTimeout(() => {
          if (!window.__motionReady) document.documentElement.classList.remove('reveal-ready');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
