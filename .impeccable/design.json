  "narrative": {
    "northStar": "El álbum de la Coral",
    "overview": "La Escolanía se presenta como un álbum familiar guardado con orgullo desde 1991: solemne como su escudo y cercano como una foto de grupo con una nota escrita a mano. El navy da la seriedad institucional, el dorado señala lo importante y el celeste del escudo abre espacio y luz.\n\nLos componentes se sienten **cálidos y seguros**: formas muy redondeadas, superficies blancas con un borde fino y profundidad contenida. Los gestos personales (una foto girada, una nota manuscrita, un subrayado) son pocos y acompañan el contenido real.",
    "keyCharacteristics": [
      "Navy para la autoridad, dorado para el acento, celeste para el aire.",
      "Fotos reales, enmarcadas y a veces levemente giradas.",
      "Notas manuscritas breves, nunca párrafos.",
      "Botones en píldora y tarjetas muy redondeadas.",
      "Sombra suave en reposo, marcada solo donde algo se eleva."
    ],
    "rules": [
      {
        "name": "The Cashea Rule",
        "body": "El amarillo de Cashea solo aparece en lo de Cashea, siempre con su tinta oscura encima. Cashea nunca se pinta en dorado institucional.",
        "section": "colors"
      },
      {
        "name": "The Readable Gold Rule",
        "body": "Sobre fondos claros, el texto dorado normal exige 4,5:1 y el grande 3:1. Por eso el texto normal usa gold-700, el grande (24px, o 18,66px en negrita) usa gold-600, y gold-500 queda para líneas, rellenos e íconos decorativos.",
        "section": "colors"
      },
      {
        "name": "The Eyebrow Rule",
        "body": "La etiqueta en mayúsculas sobre el título, con línea dorada en las secciones, es parte del sistema y se conserva.",
        "section": "typography"
      },
      {
        "name": "The Handwritten Note Rule",
        "body": "Caveat se reserva para notas cortas. Nunca lleva instrucciones, datos ni párrafos.",
        "section": "typography"
      },
      {
        "name": "The Quiet Rest Rule",
        "body": "Una tarjeta en reposo solo lleva borde fino y sombra suave. La sombra marcada queda para botones, fotos y menús.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar los tokens de `src/styles/global.css`.",
      "Do comprobar el contraste en el HTML compilado: el hook no resuelve los colores de Tailwind en archivos `.astro`.",
      "Do diseñar primero a 375px y mantener objetivos táctiles de 44px.",
      "Do usar el marco sin foto cuando falte una foto real."
    ],
    "donts": [
      "Don't cambiar las tres familias tipográficas ni la paleta del escudo.",
      "Don't usar el amarillo de Cashea fuera de Cashea.",
      "Don't usar fotos de stock ni generadas.",
      "Don't poner texto blanco sobre gold-500 ni sobre el amarillo de Cashea.",
      "Don't convertir un grupo largo en un listado vertical sin fin.",
      "Don't repartir el filete lateral de Ideario por otras tarjetas."
    ]
  }
}
